rules_version = '2';
// Tourist.uz — Firestore xavfsizlik qoidalari.
// Firebase Console → Firestore Database → Rules bo'limiga shu matnni to'liq nusxalab, "Publish" bosing.
// admin_email@example.com o'rniga admin email(lar)ini yozing. Bir nechta bo'lsa: ['a@gmail.com', 'b@gmail.com'].
// Admin email TASDIQLANGAN bo'lishi shart — eng osoni admin saytga "Google orqali kirish" bilan kiradi.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email_verified == true   // begona odam admin emailini egallab ololmasligi uchun
        && request.auth.token.email.lower() in ['admin_email@example.com'];
    }

    // Foydalanuvchi profili: har kim faqat o'zinikini yozadi/o'qiydi, admin hammasini o'qiydi
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'country', 'lang', 'lastLogin']);
    }

    // Buyurtmalar: foydalanuvchi faqat o'z nomidan "paid_demo" holatida yaratadi va faqat o'zinikini ko'radi.
    // Holatni (ishlatildi / bekor) faqat admin o'zgartiradi.
    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'paid_demo'
        && request.resource.data.code == orderId
        && request.resource.data.total is number && request.resource.data.total >= 0
        && request.resource.data.items is list && request.resource.data.items.size() <= 50;
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if isAdmin();
    }

    // Tizim sozlamalari (AI rejimi, model, ixtiyoriy Gemini kaliti): hamma o'qiydi, faqat admin o'zgartiradi
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Obidalar narxi va faolligi: hamma o'qiydi, faqat admin o'zgartiradi
    match /places/{placeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
